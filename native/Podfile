# Handwriting recognition (phase N3): Google ML Kit Digital Ink, only distributed through CocoaPods.
# After `xcodegen`: `pod install`, then open BulletLife.xcworkspace (not the .xcodeproj). See README.md.
platform :ios, '17.0'
use_frameworks!

project 'BulletLife.xcodeproj'

target 'BulletLife' do
  pod 'GoogleMLKit/DigitalInkRecognition', '9.0.0'
end

post_install do |installer|
  # As in Google's ML Kit samples: newer Xcode renamed DT_TOOLCHAIN_DIR.
  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |variant, xcconfig|
      xcconfig_path = target.client_root + target.xcconfig_relative_path(variant)
      text = IO.read(xcconfig_path).gsub("DT_TOOLCHAIN_DIR", "TOOLCHAIN_DIR")
      text += "\nCLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO\n" unless text.include?("CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER")
      IO.write(xcconfig_path, text)
    end
  end
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '17.0'
      # Google's pods include their own headers with quotes; newer Xcode flags that. Not our code: keep it quiet.
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      if config.base_configuration_reference.is_a? Xcodeproj::Project::Object::PBXFileReference
        xcconfig_path = config.base_configuration_reference.real_path
        IO.write(xcconfig_path, IO.read(xcconfig_path).gsub("DT_TOOLCHAIN_DIR", "TOOLCHAIN_DIR"))
      end
    end
  end
end
